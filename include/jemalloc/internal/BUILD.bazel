    name = "public_domain",
    full_name = "Public Domain",
    identifier = "LicenseRef-scancode-public-domain",
)

license(
    name = "murmurhash3_license",
    kind = ":public_domain",
    text = "LICENSE.murmurhash3",
)

# hash.h adapts MurmurHash3 and states no upstream version.
package_metadata(
    name = "murmurhash3_metadata",
    attributes = [":murmurhash3_license"],
    purl = "pkg:github/aappleby/smhasher#src/MurmurHash3.cpp",
)

exports_files(
    [
        "private_namespace.sh",
        "private_symbols.sh",
        "public_namespace.sh",
        "public_unnamespace.sh",
    ],
    visibility = ["//tools/fidelity:__pkg__"],
)

