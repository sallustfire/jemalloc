common --lockfile_mode=off

common:bazel8 --incompatible_resolve_select_keys_eagerly
common:bazel9 --incompatible_resolve_select_keys_eagerly

# jemalloc's transitions would otherwise carry its Starlark settings into an exec configuration of their own, which
# builds every tool again. Bazel 9 and later keep them out through each setting's scope = "target"; Bazel 8 needs
# the exclusion flag. nm is the one jemalloc setting a tool reads, so it is carried over.
common:bazel8 --experimental_exclude_starlark_flags_from_exec_config
common:bazel8 --experimental_propagate_custom_flag=@jemalloc//settings/flags:nm
