# The hermetic LLVM toolchain, with the host's C++ toolchain neither detected nor registered. It supplies no
# CcToolchainInfo.nm_executable, so //settings/flags:nm names its llvm-nm.
common --extra_toolchains=@llvm//toolchain:all
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --incompatible_strict_action_env
common --lockfile_mode=off
common --@jemalloc//settings/flags:nm=@llvm//tools:llvm-nm

common:bazel8 --incompatible_resolve_select_keys_eagerly
common:bazel9 --incompatible_resolve_select_keys_eagerly

# No exclusion of Starlark settings from exec configurations on Bazel 8, unlike examples/host_toolchain: the llvm
# toolchain builds its own runtimes through transitions whose settings must reach exec configurations, and Bazel 8
# excludes every setting not named by --experimental_propagate_custom_flag. Bazel 9 and later keep jemalloc's settings
# out through their scope = "target".
