# The harness settings every unit test library pins. A test also pins its subject, the feature it exists to test, when
# that is a portable compile-time option with no platform or toolchain dependence (:testlib_debug, :testlib_fill,
# :testlib_log, :testlib_opt_safety_checks, :testlib_opt_safety_checks_without_debug, :testlib_opt_size_checks,
# :testlib_uaf_detection). Every other setting follows the user's flags: whole-suite axes (the compilation mode, and
# with it debug, safety and size checks for tests whose subject they are not; stats) are left to whole-suite
# configurations such as CI's --config runs rather than pinned per test, and platform-dependent subjects (the prof
# backend) to those configurations and target_compatible_with.
TESTLIB_SETTINGS = {
    "//settings:enable_jet": "True",
    "//settings:with_test": "unit",
    # This needs to be pinned for testing. The MALLOC_CONF ENV depends on it. The make build allows for it to be
    # set dynamically via templating and generates a test harness around it. By requiring a value that cannot be
    # set internally by accident, this exercises the same functionality.
    "//settings/flags:jemalloc_prefix": "je_test_",
}

with_settings(
    name = "testlib",
    testonly = True,
    src = "//test:testlib",
    settings = TESTLIB_SETTINGS,
    visibility = ["//:__subpackages__"],
)

with_settings(
    name = "testlib_debug",
    testonly = True,
    src = "//test:testlib",
    settings = TESTLIB_SETTINGS | {"//settings/flags:enable_debug": "yes"},
)

with_settings(
    name = "testlib_fill",
    testonly = True,
    src = "//test:testlib",
    settings = TESTLIB_SETTINGS | {"//settings/flags:enable_fill": "True"},
)

with_settings(
    name = "testlib_log",
    testonly = True,
    src = "//test:testlib",
    settings = TESTLIB_SETTINGS | {"//settings/flags:enable_log": "True"},
)

with_settings(
    name = "testlib_opt_safety_checks",
    testonly = True,
    src = "//test:testlib",
    settings = TESTLIB_SETTINGS | {"//settings/flags:enable_opt_safety_checks": "True"},
)

