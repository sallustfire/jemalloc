load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//include/jemalloc/internal:private_namespace.bzl", "private_namespace")
load("//include/jemalloc/internal:public_symbols.bzl", "public_symbols", "public_symbols_header")
load("//include/jemalloc/internal:symbols.bzl", "ALL_PUBLIC_SYMBOLS", "ALL_WRAP_SYMBOLS", "SYM_PREFIX")
load("//tools:transition.bzl", "CPU", "PLATFORM", "transition_default_constraints")
load("//tools:version.bzl", "UPSTREAM_VERSION", "VERSION")
load(":fidelity.bzl", "fidelity_test", "private_namespace_fidelity_test")

write_file(
    name = "upstream_version",
    testonly = True,
    out = "upstream_version.txt",
    # The trailing "" ends the file with a newline, as the VERSION file does.
    content = [
        UPSTREAM_VERSION,
        "",
    ],
    newline = "unix",
)

diff_test(
    name = "version_test",
    file1 = ":upstream_version",
    file2 = "//:VERSION",
)

native_test(
    name = "configure_symbols_test",
    size = "small",
    src = "@gawk",
    args = [
        "-f",
        "$(rootpath :configure_symbols.awk)",
        "-vgid=" + VERSION.gid,
        "-vpublic=" + ",".join(ALL_PUBLIC_SYMBOLS),
        "-vwrap=" + ",".join(ALL_WRAP_SYMBOLS),
        # configure.ac adds these only alongside JEMALLOC_OVERRIDE___POSIX_MEMALIGN and JEMALLOC_GLIBC_*_HOOK, which the fork undefines
        "-vunwrapped=__posix_memalign,__free_hook,__malloc_hook,__realloc_hook,__memalign_hook",
        "$(rootpath //:configure.ac)",
    ],
    data = [
        ":configure_symbols.awk",
        "//:configure.ac",
    ],
)

fidelity_test(
    name = "jemalloc_mangle_test",
    srcs = ["//include/jemalloc/internal:public_symbols"],
    generated = "//include/jemalloc:jemalloc_mangle",
    script = "//include/jemalloc:jemalloc_mangle.sh",
    script_args = [
        "include/jemalloc/internal/public_symbols.txt",
        "je_",
    ],
)

fidelity_test(
    name = "jemalloc_mangle_jet_test",
    srcs = ["//include/jemalloc/internal:public_symbols"],
    generated = "//include/jemalloc:jemalloc_mangle_jet",
    script = "//include/jemalloc:jemalloc_mangle.sh",
    script_args = [
        "include/jemalloc/internal/public_symbols.txt",
        "jet_",
    ],
)

fidelity_test(
    name = "jemalloc_rename_test",
    srcs = ["//include/jemalloc/internal:public_symbols"],
    generated = "//include/jemalloc:jemalloc_rename",
    script = "//include/jemalloc:jemalloc_rename.sh",
    script_args = ["include/jemalloc/internal/public_symbols.txt"],
)

fidelity_test(
    name = "public_namespace_test",
    srcs = ["//include/jemalloc/internal:public_symbols"],
    generated = "//include/jemalloc/internal:public_namespace",
    script = "//include/jemalloc/internal:public_namespace.sh",
    script_args = ["include/jemalloc/internal/public_symbols.txt"],
)

fidelity_test(
    name = "public_unnamespace_test",
    srcs = ["//include/jemalloc/internal:public_symbols"],
    generated = "//include/jemalloc/internal:public_unnamespace",
    script = "//include/jemalloc/internal:public_unnamespace.sh",
    script_args = ["include/jemalloc/internal/public_symbols.txt"],
)

fidelity_test(
    name = "jemalloc_test",
    srcs = [
        "//include/jemalloc:jemalloc_defs",
        "//include/jemalloc:jemalloc_macros",
        "//include/jemalloc:jemalloc_mangle",
        "//include/jemalloc:jemalloc_protos",
        "//include/jemalloc:jemalloc_rename",
        "//include/jemalloc:jemalloc_typedefs",
    ],
    generated = "//include/jemalloc",
    script = "//include/jemalloc:jemalloc.sh",
    script_args = [""],
)

_MANGLING_MAP = "malloc:my malloc,free:,  unknown:u_x,calloc:a:b,"

_MANGLING_SYMBOLS = [
    "calloc",
    "free",
    "malloc",
    "mallocx",
]

public_symbols(
    name = "public_symbols_mangling",
    testonly = True,
    out = "public_symbols_mangling.txt",
    mangling_map = _MANGLING_MAP,
    symbols = _MANGLING_SYMBOLS,
    tags = ["manual"],
)

fidelity_test(
    name = "public_symbols_mangling_test",
    srcs = ["//:configure.ac"],
    generated = ":public_symbols_mangling",
    script = ":configure_commands.sh",
    script_args = [
        "configure.ac",
        "include/jemalloc/internal/public_symbols.txt",
        "mangling_map=" + _MANGLING_MAP,
        "public_syms=" + " ".join(_MANGLING_SYMBOLS),
        "JEMALLOC_PREFIX=:je_",
    ],
    settings = {"//settings/flags:jemalloc_prefix": ":je_"},
)

public_symbols_header(
    name = "jemalloc_rename_mangling",
    testonly = True,
    out = "jemalloc_rename_mangling.h",
    public_symbols = ":public_symbols_mangling",
    script = "jemalloc_rename.sh",
    tags = ["manual"],
)

fidelity_test(
    name = "jemalloc_rename_mangling_test",
    srcs = [":public_symbols_mangling"],
    generated = ":jemalloc_rename_mangling",
    script = "//include/jemalloc:jemalloc_rename.sh",
    script_args = ["tools/fidelity/public_symbols_mangling.txt"],
    settings = {"//settings/flags:jemalloc_prefix": ":je_"},
)

