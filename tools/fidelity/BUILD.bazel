filegroup(
    name = "configured_headers",
    srcs = [
        "//include/jemalloc",
        "//include/jemalloc:jemalloc_mangle",
        "//include/jemalloc:jemalloc_mangle_jet",
        "//include/jemalloc:jemalloc_rename",
        "//include/jemalloc/internal:private_namespace",
