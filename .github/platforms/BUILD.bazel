# The platform of the Windows job's clang-cl leg, which builds on it and for it. rules_cc's auto-configured clang-cl
# toolchain requires the clang-cl compiler constraint on its execution platform; without it the msvc-cl toolchain,
# which requires none, is chosen.
platform(
    name = "x64_windows-clang-cl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@rules_cc//cc/private/toolchain:clang-cl",
    ],
)
