    srcs = [
               "src/arena.c",
               "src/background_thread.c",
               "src/base.c",
               "src/bin.c",
               "src/bin_info.c",
               "src/bitmap.c",
               "src/buf_writer.c",
               "src/cache_bin.c",
               "src/ckh.c",
               "src/counter.c",
               "src/ctl.c",
               "src/decay.c",
               "src/div.c",
               "src/ecache.c",
               "src/edata.c",
               "src/edata_cache.c",
               "src/ehooks.c",
               "src/emap.c",
               "src/eset.c",
               "src/exp_grow.c",
               "src/extent.c",
               "src/extent_dss.c",
               "src/extent_mmap.c",
               "src/fxp.c",
               "src/hook.c",
               "src/hpa.c",
               "src/hpa_hooks.c",
               "src/hpdata.c",
               "src/inspect.c",
               "src/jemalloc.c",
               "src/large.c",
               "src/log.c",
               "src/malloc_io.c",
               "src/mutex.c",
               "src/nstime.c",
               "src/pa.c",
               "src/pa_extra.c",
               "src/pac.c",
               "src/pages.c",
               "src/pai.c",
               "src/peak_event.c",
               "src/prof.c",
               "src/prof_data.c",
               "src/prof_log.c",
               "src/prof_recent.c",
               "src/prof_stats.c",
               "src/prof_sys.c",
               "src/psset.c",
               "src/rtree.c",
               "src/safety_check.c",
               "src/san.c",
               "src/san_bump.c",
               "src/sc.c",
               "src/sec.c",
               "src/stats.c",
               "src/sz.c",
               "src/tcache.c",
               "src/test_hooks.c",
               "src/thread_event.c",
               "src/ticker.c",
               "src/tsd.c",
               "src/witness.c",
           ] + select({
               "//settings/compiler:msvc_compatible": [
                   "include/msvc_compat/strings.h",
                   "include/msvc_compat/windows_extra.h",
               ],
               "//conditions:default": [],
           }) + select({
        "//settings/flags:cxx": ["src/jemalloc_cpp.cpp"],
        "//conditions:default": [],
    }),
    hdrs = ["//include/jemalloc"],
    conlyopts = CONLYOPTS,
    copts = _LIB_COPTS,
    cxxopts = CXXOPTS,
    includes = ["include"],
    linkopts = select({
        "@platforms//os:android": ["-ldl"],
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }) + select({
        "//settings/flags:prof": ["-lm"],
        "//conditions:default": [],
    }),
    local_defines = _LIB_LOCAL_DEFINES,
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = ["//include/jemalloc/internal"] + select({
        "//settings/flags:prof_libunwind": ["@libunwind"],
        "//conditions:default": [],
    }),
)

# On macOS jemalloc replaces malloc by registering a malloc zone from src/zone.c's constructor, which nothing references.
# A static link of an archive drops such an object, so malloc would silently stay on the system allocator. Upstream
# avoids this only by linking the dylib on macOS, which loads every object; its static libjemalloc.a has the same hole.
#
# Only the zone is linked whole. Linking the whole core instead would also force jemalloc_cpp.o's global operator
# new/delete into every binary, which then fails to link with duplicate symbols when an application defines its own
# (examples:test_10_macos_custom_operators). The zone still pulls in the core objects it calls, jemalloc.o and its
# constructor among them, and any operator new or delete overload that a binary calls without defining still pulls in
# jemalloc_cpp.o, with all of its overloads, as before: an application replacing the operators must replace every
# overload it calls. This narrows what is linked whole; it does not isolate allocators.
cc_library(
    name = "lib/jemalloc_zone",
    srcs = ["src/zone.c"],
    conlyopts = CONLYOPTS,
    copts = _LIB_COPTS,
    cxxopts = CXXOPTS,
    includes = ["include"],
    local_defines = _LIB_LOCAL_DEFINES,
    alwayslink = True,
    tags = ["manual"],
    # zone.c is darwin-only and stops with #error without the zone allocator, which only the platform transition
    # resolves; build it through lib/jemalloc.
    target_compatible_with = select({
        "//settings/flags:zone_allocator": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = [
        ":lib/jemalloc_core",
        "//include/jemalloc/internal",
    ],
)

# The library every consumer and test links. Whether it includes the zone is an implementation detail: it does where
# the zone allocator is on, as upstream compiles src/zone.c into the library only then.
cc_library(
    name = "lib/jemalloc",
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
    # lib/jemalloc_zone depends on the core, so either branch links the core
    deps = select({
        "//settings/flags:zone_allocator": [":lib/jemalloc_zone"],
        "//conditions:default": [":lib/jemalloc_core"],
    }),
)

transition_default_constraints(
    name = "jemalloc_with_defaults",
    src = ":lib/jemalloc",
    platform = PLATFORM,
    settings = {},
)

# C_UTIL_INTEGRATION_SRCS from the Makefile which are shared with the integration testlib
cc_library(
    name = "utils",
    srcs = [
        "src/malloc_io.c",
        "src/nstime.c",
        "src/ticker.c",
    ],
    hdrs = ["//include/jemalloc"],
    conlyopts = CONLYOPTS,
    copts = ["-Iinclude/jemalloc/internal"] + COPTS,
    cxxopts = CXXOPTS,
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
    deps = ["//include/jemalloc/internal"],
)
